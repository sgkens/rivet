{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "description": "{{DISPLAY_NAME}} library.",
  "type": "module",
  "main": "./dist/{{PROJECT_NAME}}.cjs",
  "module": "./dist/{{PROJECT_NAME}}.mjs",
  "browser": "./dist/{{PROJECT_NAME}}.js",
  "types": "./src/{{PROJECT_NAME}}.d.ts",
  "exports": {
    ".": {
      "import": "./dist/{{PROJECT_NAME}}.mjs",
      "require": "./dist/{{PROJECT_NAME}}.cjs",
      "default": "./dist/{{PROJECT_NAME}}.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "branding",
    "README.md",
    "LICENSE",
    "jsr.jsonc"
  ],
  "scripts": {
    "dev": "vite",
    "docs:build": "npm run build && hugo --source docs",
    "docs:serve": "npm run build && hugo server --source docs --buildDrafts --disableFastRender --ignoreCache --noHTTPCache --gc",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "staticcanvas",
    "esm"
  ],
  "author": "Garvey K. Snow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/{{PROJECT_PATH}}.git"
  },
  "homepage": "https://{{NAMESPACE}}.gitlab.io/{{PROJECT_NAME}}",
  "bugs": {
    "url": "https://gitlab.com/{{PROJECT_PATH}}/-/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "rollup-plugin-copy": "^3.5.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
