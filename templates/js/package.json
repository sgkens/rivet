{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "description": "{{DISPLAY_NAME}} library.",
  "type": "module",
  "main": "./dist/{{PROJECT_NAME}}.cjs",
  "module": "./dist/{{PROJECT_NAME}}.mjs",
  "browser": "./dist/{{PROJECT_NAME}}.js",
  "types": "./src/{{PROJECT_NAME}}.d.ts",
  "exports": {
    ".": {
      "import": "./dist/{{PROJECT_NAME}}.mjs",
      "require": "./dist/{{PROJECT_NAME}}.cjs",
      "default": "./dist/{{PROJECT_NAME}}.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "jsr.jsonc"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:bun": "bun test",
    "test:coverage:bun": "bun test --coverage",
    "check:size": "node scripts/check-bundle-size.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "check:quality": "npm run build && npm run check:size && npm test"
  },
  "keywords": [
    "javascript",
    "esm"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "{{GITLAB_BASE_URI}}/{{PROJECT_PATH}}.git"
  },
  "homepage": "{{PROJECT_URL}}",
  "bugs": {
    "url": "{{GITLAB_BASE_URI}}/{{PROJECT_PATH}}/-/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
